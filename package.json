{
  "name": "bb-plugin-antigravity-cli",
  "version": "0.1.12",
  "type": "module",
  "license": "MIT",
  "description": "Use the installed Antigravity CLI as an ACP agent in BB.",
  "keywords": [
    "bb-plugin",
    "antigravity",
    "acp",
    "cli",
    "gemini",
    "claude",
    "planning"
  ],
  "files": [
    "server.ts",
    "host.ts",
    "cli.ts",
    "compaction.ts",
    "background-tasks.ts",
    "subagents.ts",
    "dialect.ts",
    "prompt-mode.ts",
    "mode-controls.ts",
    "usage.ts",
    "dist/*.js",
    "dist/*.css",
    "dist/*.meta.json",
    "!dist/*.map",
    "README.md",
    "LICENSE",
    "PLUGIN_OVERVIEW.md",
    "SECURITY.md",
    "docs",
    "assets",
    "skills"
  ],
  "engines": {
    "bb": ">=0.48",
    "bbPluginSdk": ">=0.6.104 <0.7",
    "node": ">=22"
  },
  "bb": {
    "name": "Antigravity CLI Provider [Experimental]",
    "description": "Plan and code with Google Antigravity inside BB. Choose a model and reasoning level, review tool requests, and check quota and reset times. Requires the standalone CLI and an eligible account. Antigravity quota or charges apply. Tested on Windows and expected to work on Linux.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "skills": [
      "skills"
    ]
  },
  "bbMarketplace": {
    "category": "agents-and-providers",
    "screenshots": [
      "./assets/screenshots/marketplace-overview.png"
    ]
  },
  "scripts": {
    "build": "bb plugin build",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.178",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ols-md/bb-plugin-antigravity.git"
  }
}
